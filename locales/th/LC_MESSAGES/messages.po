#: bot/config_handler.py:518
msgid "\nConfiguration saved to config.ini! You can now start the bot normally."
msgstr "\nบันทึกการตั้งค่าลง config.ini แล้ว ตอนนี้คุณสามารถเปิดบอทได้ตามปกติ"

#: bot/config_handler.py:80
msgid "A comma-separated list of country names to ban from the server (e.g., North Korea,Israel)."
msgstr "รายชื่อประเทศที่ต้องการแบนออกจากเซิร์ฟเวอร์ คั่นแต่ละชื่อด้วยเครื่องหมายจุลภาค เช่น North Korea,Israel"

#: bot/config_handler.py:85
msgid "A comma-separated list of nicknames to confine to the jail channel."
msgstr "รายชื่อชื่อเล่นที่จะให้ย้ายเข้าห้องกักกันอัตโนมัติ คั่นด้วยจุลภาค"

#: bot/config_handler.py:84
msgid "A comma-separated list of usernames to automatically confine to the jail channel upon login."
msgstr "รายชื่อชื่อผู้ใช้ที่จะให้ย้ายเข้าห้องกักกันอัตโนมัติเมื่อเข้าสู่ระบบ คั่นด้วยจุลภาค"

#: bot/modules/account_requests.py:214
